feature_rotten_desc = "Returns \1 damage when non-lethally hit."
feature_rotten_text_bubble_name = "Rotten: Attack"
feature_stickandstones_name = "Anger"
feature_stickandstones_desc = "Adds +\1 to its Strength every time it receives damage."
