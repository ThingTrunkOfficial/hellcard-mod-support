###########################################################################################################
# Loading Screen Tips
###########################################################################################################

game_tip_000 = "You can use keyboard shortcuts for communication. Press V, then A, and Q to say 'Hi!'."
game_tip_001 = "Click \sz0 on other heroes' avatars to see their decks and maps."
game_tip_001_pad = "Press \szM or \sz> on other heroes' avatars to see their decks and maps."
game_tip_002 = "Sometimes NOT taking a card on the reward screen is the best choice."
game_tip_003 = "You can ask companions in Singleplayer mode to change their Location choice when looking at their maps."
game_tip_004 = "\s: Summoners can easily overwhelm you with minions. Kill them as soon as possible."
game_tip_005 = "Monsters with \s9 rotten hearts (like zombies) return 1 damage when non-lethally hit."
game_tip_006 = "\s; Gluttons get stronger every time they are attacked."
game_tip_007 = "\s< Chaotic Goat leaves a Healing Blood card when killed. Use it to your advantage."
game_tip_008 = "Killed \s= cursed ghosts Weaken their killers until the end of the turn. Kill them at the end of your turn!"
game_tip_009 = "\s> Exploding monsters (like Fire Imps) deal damage to all heroes when killed in the near range."
game_tip_010 = "\s? Vampiric monsters (like Succubus) become stronger every time they deal damage."
game_tip_011 = "Attack cards are red. They deal damage in different ways."
game_tip_012 = "Skill cards are blue. Their main purpose is support - giving block, mana, drawing cards, etc."
game_tip_013 = "Influence cards are green. They grant influences - buffs that usually last for the whole battle."
game_tip_014 = "Status cards are black and have negative effects on you."
game_tip_015 = "When creating a character, you can trade initial gemstones \s@ for starting artifacts."
game_tip_016 = "Unlock Torment modifiers by finishing runs and use them when creating future characters to increase run challenge."
game_tip_017 = "Each finished run gives you experience points that unlock new cards and artifacts for the current character class."
game_tip_018 = "Each finished run gives you experience points that unlock cosmetics (like outfits or emotes) regardless of the character class you played."
game_tip_019 = "You can select more than one character when matchmaking. The game will find the best fit lobby for one of the selected characters."
game_tip_020 = "Only characters on the 12th floor can fight with the final boss."
game_tip_021 = "Unripe Banana pairs nicely with Miniature Chair."
game_tip_022 = "Sometimes skeletons lose their heads. Please do not point and stare."
game_tip_023 = "Hero's incoming damage indicator takes all buffs and debuffs into consideration. It always shows the correct, final value."
game_tip_024 = "After each battle, you will have access to Locations chosen by all the players/companions."
game_tip_025 = "You can enable fast monster turn in Options. In Multiplayer mode all the players have to enable the option."
game_tip_026 = "When a base card damage equals 0, it is not modified by influences"
game_tip_027 = "Archdemon's special ability (Round Robin) also affects influences which replay cards." 
game_tip_total = "28"


