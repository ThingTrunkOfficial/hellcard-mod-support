###########################################################################################################
# OCTOPUS VOICE LINES
###########################################################################################################

rsum_firstwin1 = "You made it! It's the first time of many, many more! Hahahaha!"
rsum_win_war1 = "Crude force and iron prevail, at last!"
rsum_win_rog_notfirst1 = "Finally, a new face at the finish line! Now off to the start you go!"
rsum_win_torment1 = "Wow, I'm so impressed I almost dropped your universe. We wouldn't want that! Nope."
rsum_win_torment2 = "That's more scary than impressive, really!"
rsum_win_torment3 = "Stop, you are being scary!"
rsum_win_torment4 = "We are having such a great time together. And we are only getting started."
rsum_win_notfirst1 = "Boooriiing. Eh, I guess that's on me. Made it too easy!"
rsum_win_notfirst2 = "Fun fact: when I shake this ball it snows in your universe!"
rsum_win_notfirst3 = "You are getting hang of it, but so am I! Let's spice things up a bit!"
rsum_win_notfirst4 = "Impressive! But can you do it without getting hit?"
rsum_win_notfirst5 = "You get all the accolades when it's me setting the board! Haha!"
rsum_win_notfirst6 = "You again?"
rsum_win_notfirst7 = "So much effort just to entertain me! Lovely!"
rsum_win_notfirst8 = "Don't tell the others, your plays are my favorite!"
rsum_win_notfirst9 = "I made you a medal, but I already gave it to myself!"
rsum_win_notfirst10 = "I always liked you the most. Don't tell the others."
rsum_win_notfirst11 = "All winning and no joy make you a dull toy."
rsum_win_notfirst12 = "Do you sometimes feel like someone is watching you?" 
rsum_win_notfirst13 = "I think this universe could use way more spiders."
rsum_win_notfirst14 = "This thing must be broken! Impossible!"
rsum_win_notfirst15 = "Stop being boring, die already!"
rsum_win1 = "What? I made it too easy! Let's see how you do now!"
rsum_win2 = "Good attempt. Very amusing. 5 out of 7."
rsum_win3 = "You earned this. You are the real hero of this particular story, after all!"
rsum_win4 = "I'm defeated! Argh! Hahaha."
rsum_win5 = "No! You are not allowed to win!"
rsum_win6 = "Letting you win was the plan! Gah!"
rsum_win7 = "No! No! Noo! You are damaging the ball, dad will get maaaad!"
rsum_win8 = "Let's see if you can do it again after I mess with the probability distribution!"
rsum_win9 = "Win some, lose some. In your case, everything!"
rsum_win10 = "I made 14,000,605 universes. You win only in this one." 
rsum_win11 = "So much fun! And we will have so much more of it. Together."
rsum_defeat_notfirst1 = "Would you rather fight a demon-sized duck or a duck-sized demon? I could create either for your next try."
rsum_defeat_notfirst2 = "Hmm, maybe I should make one of those minions the hero?"
rsum_defeat_notfirst3 = "The point of a self-harm strategy is not to overdo it, you know?"
rsum_defeat_notfirst4 = "Mess with the octopus, die like a... platypus? This one needs more work." 
rsum_defeat_notfirst5 = "I win! Again!"
rsum_defeat_notfirst6 = "If you don't want to die so often, try getting hit less."
rsum_defeat1 = "Finished so soon? Never happened before, eh?"
rsum_defeat2 = "You not only look like bugs from up here, you fight like them too!"
rsum_defeat3 = "This was where the fun was about to start, try harder!"
rsum_defeat4 = "You did well. Your friends, though..."
rsum_defeat5 = "If you'd only picked that other card back then..."
rsum_defeat6 = "The point is *not* to die!"
rsum_defeat7 = "If you try way, way harder you might eventually die a bit further."
rsum_defeat8 = "Shame, you guys looked like you could've made it. "
rsum_defeat9 = "Ugh this is so frustrating! You almost had it!"
rsum_defeat10 = "Play with me again! Again! "
rsum_defeat11 = "I think we started off on the wrong foot. Let's try again."
rsum_defeat12 = "You know you don't have to pick *every* card on your way, right?"
rsum_defeat13 = "It's not you. It was all of you. "
rsum_defeat14 = "Totally should have blocked when you attacked instead. "
rsum_defeat15 = "You should balance your deck better. Try the not-dead-out-of-the gate build next. "
rsum_defeat16 = "Oooh, was that a self-harm strategy? Never go full self-harm. "
rsum_defeat17 = "That was *mildly* amusing! More so for me but don't get discouraged! So much fun ahead."
rsum_unlock1 = "Curious, I don't recall making that."
rsum_unlock2 = "How did you find this?"
rsum_unlock3 = "*Where* is this stuff coming from?"
rsum_unlock4 = "That's unexpected... might be interesting though. I'm letting you keep it."
rsum_unlock_notfirst1 = "Think this will change anything?"
rsum_unlock_notfirst2 = "You seem to enjoy these trinkets. Think they will help? Haha. "
rsum_unlock_notfirst3 = "You think this gives you an advantage? Duh. "
rsum_unlock_notfirst4 = "I will just spawn more monsters, this changes NOTHING!"
rsum_unlock_notfirst5 = "Oh, you found it again. "
rsum_unlock_notfirst6 = "I wouldn't pick that. Less is more. "
rsum_unlock_notfirst7 = "I totally placed it there for you to find. "
rsum_unlock_notfirst8 = "That doesn't even look useful. "
rsum_unlock_notfirst9 = "I guess you deserve a new toy for being such a great one yourself, hahaha!"
rsum_unlock_notfirst10 = "Well, maybe this *will* spice things up a bit. "
rsum_unlock_notfirst11 = "Booooorrrrring."
rsum_unlock_notfirst12 = "Doubt you will know how to use it anyway!"
rsum_unlock_notfirst13 = "I will find out where this stuff is coming from!"
rsum_unlock_notfirst14 = "Is this thing working? How are you finding this stuff? "
rsum_unlock_notfirst15 = "I have three of these, overhyped. "



###########################################################################################################
# TUTORIALS
###########################################################################################################

tutorial_click_to_dismiss = "Click to dismiss"
tutorial_click_to_dismiss_pad = "\sz? to dismiss"
tutorial_close = "Close"
tutorial_close_pad = "Close \szA"
tutorial_next = "Next"
tutorial_next_pad = "Next \szA"
tutorial_skip_all = "Skip All"
tutorial_skip_all_pad = "Skip All \sz?"

tut_multiplayer_name = "Co-op Multiplayer"
tut_multiplayer_text_0 = "The easiest way to play with others is to use the \^fed623Quickplay\^^ mode.\n\nJust \^fed623check\^^ any number of your characters and use the \^fed623Quickplay button\^^. This will \^fed623automatically find\^^ available games and \^fed623join\^^ the best matching one.\n\nThe character in the center is always \"checked\" and selected."
tut_multiplayer_text_1 = "You can also create your own \^fed623Lobby\^^ with a \^fed623selected character\^^.\n\nYou can then either \^fed623search for players\^^ or \^fed623invite friends\^^.\n\nGames created in both modes are \^fed623compatible\^^ with each other."
tut_multiplayer_text_2 = "Players play their cards \^fed623simultaneously.\^^ The turn ends when all the players press \^fed623End Turn\^^."


tut_starting_artifact_name = "Starting Artifacts"
tut_starting_artifact_text_0 = "You have \^fed623unlocked\^^ a starting artifact for your character. From now on, your new characters can \^fed623start\^^ their run with \^fed623one or more\^^ of them."
tut_starting_artifact_text_1 = "Each artifact \^fed623costs gemstones\^^ to equip.\nYou can select \^fed623as many\^^ starting artifacts as you want as long as you have \^fed623enough gemstones\^^."

tut_death_multi_name = "Death Is Not The End"
tut_death_multi_text_0 = "You have \^fed623fallen\^^ in battle.\nYou can \^fed623no longer play cards\^^ or take other active actions during this fight."
tut_death_multi_text_1 = "If you \^fed623exit\^^ the game now, your character will be \^fed623lost\^^. But if you \^fed623stay\^^ and your party \^fed623wins\^^ this fight, you will be \^fed623resurrected\^^."
tut_death_multi_text_2 = "If your team \^fed623survives\^^ you will get \^fed623rewards\^^ as usual!"
tut_death_multi_text_3 = "You can help your team by facilitating \^fed623communication\^^ and \^fed623coordinating\^^ their moves."


tut_communication_name = "Communication with Other Players"
tut_communication_text_0 = "\^fed623Cooperation\^^ is key to victory. \^fed623Click\^^ on your teammates' \^fed623avatars\^^ to see their \^fed623decks and maps\^^."
tut_communication_text_0_pad = "\^fed623Cooperation\^^ is key to victory. \^fed623Press\^^ \szM or \sz> on your teammates' \^fed623avatars\^^ to see their \^fed623decks and maps\^^."
tut_communication_text_1 = "During the battle, \^fed623R-click\^^ on a spot on the floor or a monster to draw other players' attention to it. \^fed623R-click and hold\^^ to show ping options."
tut_communication_text_1_pad = "During the battle, use \szI to draw other players' attention. \^fed623Hold\^^ \szI to show ping options."
tut_communication_text_2 = "You can always \^fed623communicate\^^ with your team using \^fed623preset messages and icons\^^. \^fed623Click\^^ on the \^fed623communication icon\^^ or press the \^fed623V\^^ key to access them."
tut_communication_text_2_pad = "You can always \^fed623communicate\^^ with your team using \^fed623preset messages and icons\^^. Use \szG to access them."
tut_communication_text_3 = "Your teammates can see which card you picked and \^fed623where you are aiming\^^! You can also \^fed623see their picked cards and targets\^^."


tut_battle_name_0 = "Battle (page 4/4)"
tut_battle_name_1 = "Battle (page 1/4)"
tut_battle_name_2 = "Battle (page 2/4)"
tut_battle_name_3 = "Battle (page 3/4)"

tut_battle_text_0 = "Each hero has their own part of the battlefield called a \^fed623slice\^^. Each slice has two \^fed623sections\^^ - \^fed623near\^^ and \^fed623far\^^.\n\n\^fed623Melee\^^ monsters attack from the \^fed623near range only\^^ and \^fed623ranged\^^ ones only from the \^fed623far range\^^."
tut_battle_text_1 = "Defeat monsters by playing cards from your hand.\n\nCards require \^fed623mana\^^ to play.\nOnce you are out, \^fed623end your turn\^^.\n\nAt the start of your turn, your \^fed623mana\^^ is replenished and new cards are drawn."
tut_battle_text_2 = "You can see incoming damage above your head.\n\nPlay a card with \^fed623Block\^^ trait to defend yourself or your friends.\n\n\^fed623Block\^^ reduces incoming damage but is \^fed623removed\^^ at the start of your next turn."
tut_battle_text_3 = "You can tell what the monster is planning to do by looking at the \^fed623Intent\^^ over their head.\n\nLook out not only for monsters that \^fed623attack\^^ you but also for those that are \^fed623summoning\^^ or \^fed623buffing\^^.\n\nSome cards can change monster intents."

tut_companion_battle_name_0 = "Companions in Battle (page 1/4)"
tut_companion_battle_name_1 = "Companions in Battle (page 2/4)"
tut_companion_battle_name_2 = "Companions in Battle (page 3/4)"
tut_companion_battle_name_3 = "Companions in Battle (page 4/4)"

tut_companion_battle_text_0 = "\^fed623Companions\^^ help you during battles.\nThey have \^fed623mana\^^, \^fed623hand\^^, \^fed623draw\^^ and \^fed623discard piles\^^ the same as you."
tut_companion_battle_text_1 = "Companions will \^fed623choose 2 cards\^^ from their hand and present them to you. \nWhen possible, one card will be \^fed623offensive\^^ and one \^fed623defensive\^^."
tut_companion_battle_text_2 = "You can \^fed623play\^^ companions' \^fed623cards\^^ in the same way as \^fed623your own cards\^^. After you \^fed623play\^^ their \^fed623card\^^, they will \^fed623show\^^ you a \^fed623new card\^^ when possible."
tut_companion_battle_text_3 = "Every time companions \^fed623draw cards\^^ or \^fed623get mana\^^ they might \^fed623change their chosen cards\^^."
tut_companion_battle_text_4 = "To see companions' \^fed623whole hand\^^ you can either \^fed623right click\^^ on any card in hand or \^fed623press J\^^ key.\n\nThis lets you play any of their cards.\n\nClicking or pressing \^fed623again\^^ will \^fed623go back\^^ to your hand."
tut_companion_battle_text_4_pad = "To see companions' \^fed623whole hand\^^ you can use \szF.\n\nThis lets you play any of their cards.\n\nUse \szF \^fed623again\^^ to \^fed623go back\^^ to your hand."

tut_torments_name = "Torments"
tut_torments_text_0 = "Torments \^fed623increase the difficulty\^^ of your current character's run. You \^fed623unlock\^^ a new torment modifier each time you \^fed623win a run\^^."
tut_torments_text_2 = "You can select \^fed623one or more modifiers\^^ depending on the difficulty you want. Each modifier has \^fed623an effect\^^ and \^fed623a point cost\^^."
tut_torments_text_1 = "The \^fed623more points\^^ all the selected modifiers have, the \^fed623higher\^^ the final \^fed623torment level\^^ you will be playing on."
tut_torments_text_3 = "You need to \^fed623win a run\^^ on a certain torment level to have \^fed623more torment points\^^ available next time."

tut_run_finished_name = "Run finished"
tut_run_defeated_text_0 = "You have finished your run!\n\nYour heroes \^fed623died\^^, but the world mysteriously \^fed623reset\^^ to the time before they embarked on their quest. Maybe the next heroes you create will avenge them and break this cycle!\n\nWith each \^fed623finished run\^^ you unlock \^fed623new cards and artifacts\^^ for the next heroes to use."
tut_run_victorious_text_0 = "You have finished your run!\n\nYour hero was \^fed623victorious\^^, but the world mysteriously \^fed623reset\^^ to before their quest. Was it all a dream? Another hero you create can try following in their footsteps and see if they can stop this cycle!\n\nWith each \^fed623finished run\^^ you \^fed623unlock\^^ new \^fed623cards\^^ and \^fed623artifacts\^^ for your future heroes."


tut_progress_bar_name = "Map"
tut_progress_bar_text = "On each floor you have a choice between \^fed623two monsters\^^ guarding \^fed623different Locations\^^.\n\n\^fed623Each hero\^^ makes their \^fed623own choice\^^.\n\nAfter winning the battle, \^fed623everyone\^^ on the team can visit \^fed623each Location\^^."

tut_locations_name = "Adventure Screen"
tut_locations_text = "Here you can access all Locations selected by your team on the \^fed623Map\^^.\n\nYou can spend \^fed623gemstones\^^ on \^fed623one\^^ option in each of the three Locations."

tut_after_death_name = "Recovery"
tut_after_death_text = "When the \^fed623team survives\^^ a battle, fallen heroes are \^fed623resurrected\^^.\n\nThey go straight to the \^fed623Camp\^^ instead of the chosen Location so they can recover."

tut_influence_name = "Influences"
tut_influence_text = "Influences are \^fed623buffs\^^ or \^fed623debuffs\^^ that work \^fed623over time\^^.\n\n\^fed623Hover\^^ over them to find out how they \^fed623work\^^ and what \^fed623triggers\^^ them."

tut_monster_features_name = "Monster features"
tut_monster_features_text = "Some \^fed623monsters\^^ have \^fed623special features\^^ that will affect the fight.\n\nLook for \^fed623special heart icons\^^ over them and read their \^fed623tooltips\^^ for details."

tut_card_transform_name = "Transforming a card"
tut_card_transform_text = "Transforming a card means \^fed623evolving\^^ it to a \^fed623higher rarity\^^ card with \^fed623similar effects\^^.\n\nMost cards have \^fed623more than one card\^^ you can transform them into."

tut_torment_unlocked_name = "Torments unlocked!"
tut_torment_unlocked_text = "You have \^fed623unlocked\^^ your first \^fed623torment modifier\^^. From now on, you can use it to \^fed623create characters\^^ with a \^fed623higher difficulty\^^ setting."

tut_torment_modifiers_name = "Torment modifiers"
tut_torment_modifiers_text = "From now on, you can \^fed623create characters\^^ with custom \^fed623torment level modifiers\^^ (higher difficulty)."

tut_fast_monster_turn_name = "Fast monster turn"
tut_fast_monster_turn = "You can enable fast monster turn in \^fed623Options\^^. In Multiplayer mode, all the players have to enable the option."

