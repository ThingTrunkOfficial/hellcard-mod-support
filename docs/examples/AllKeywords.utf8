action_disarm_desc = "Prevents hero from getting block from their own cards."
feature_giveHealingBlood_name = "Healing Blood"
feature_giveHealingBlood_desc = "Gives Healing Blood card to its killer upon death."
feature_giveWeak_name = "Cursed"
feature_giveWeak_desc = "Adds a negative influence to its killer upon death."
feature_explode_name = "Explode"
feature_explode_desc = "Deals damage equal to its Strength to all heroes when killed while in near range."
feature_regenerate_name = "Regenerate"
feature_regenerate_desc = "Heals itself at the beginning of monsters' turn."
feature_round_robin_name = "Round robin"
feature_round_robin_desc = "No one can play a card twice in a row as long as 2 or more players are alive. This also affects influences which replay cards." 
feature_vampiricattack_name = "Vampiric"
feature_vampiricattack_desc = "Gains Strength equal to unblocked damage dealt."
feature_vampiricattack_text_bubble_name = "Vampiric Attack"
feature_immunetofreeze_name = "Immune to Freeze"
feature_arcane_shield_name = "Arcane Shield"
feature_arcane_shield_desc = "Never gets more than \1 damage in a single hit. Doesn't apply to influences doing direct damage."
feature_stone_skin_name = "Stone Skin"
feature_stone_skin_desc = "All monsters' block stays for the next turn."
feature_reverence_name = "Sinister reverence"
feature_reverence_desc = "Players together can play only a limited number of cards in each turn."
feature_thickskin_name = "Thick Skin"
feature_thickskin_desc = "Can get only limited damage from cards in each turn."
feature_hellishkitchen_name = "Hellish Kitchen"
feature_hellishkitchen_desc = "Each turn, each player gets a random Meat card."
feature_whoppersrib_name = "Whopper's Rib"
feature_whoppersrib_desc = "Spawns a new Skeleton Warrior every time it receives damage."
feature_magic_disruption_name = "Magic Disruption"
feature_magic_disruption_desc = "Skill (blue) cards cost 1 mana more."
feature_magic_barrier_name = "Magic Barrier"
feature_magic_barrier_desc = "Play other cards before Attack cards."
feature_PushCauldrons_name = "Lunch Break"
feature_PushCauldrons_desc = "Spawns monsters at the beginning of each turn."

feature_sticky_name = "Sticky"
feature_sticky_desc = "Webs a card that killed it."

feature_bond_name = "Bond"
feature_bond_desc = "After death redistributes its Strength among other monsters with this feature."

feature_hard_shell_name = "Hard Shell"
feature_hard_shell_desc = "When in far range, never gets more than \1 damage in a single hit. Doesn't apply to influences doing direct damage."

feature_hot_name = "Hot"
feature_hot_desc = "Immune to Freeze."

feature_bone_collector_name = "Bone Collector"
feature_bone_collector_desc = "On death summons a random skeleton."

feature_chitin_armor_name = "Chitin Armor"
feature_chitin_armor_desc = "Gets \1 block every time it gets hit."

feature_split_on_death_name = "Split on Death"
feature_split_on_death_desc = "On death summons 2 Arachnids in the same section."

feature_enrage_name = "Enrage"
feature_enrage_desc = "Each time this monster gets hit, all Zombies get +\1 Strength."

feature_inspiration_name = "Inspiration"
feature_inspiration_desc = "After death increases Strength of monsters in medium radius by \1."

feature_laying_eggs_name = "Laying Eggs"
feature_laying_eggs_desc = "At the end of the monster turn, spawns a Spider Egg for every monster killed that turn."

feature_chieftain_name = "Chieftain"
feature_chieftain_desc = "If it wasn't damaged this turn, all monsters gain +\1 Strength."

feature_amok_name = "Amok"
feature_amok_desc = "Gains +\1 Strength each time a monster is killed in the same section."

feature_cry_havoc_name = "Cry Havoc"
feature_cry_havoc_desc = "If Heroes didn't receive unblocked damage from monster attacks last turn, all other non-boss monsters change their intent to Attack, if possible."

feature_heartlet_of_stone_name = "Heartlet of Stone"
feature_heartlet_of_stone_desc = "Each time after this monster loses HP, other monsters in the same sector gain 1 block."

feature_heart_of_stone_name = "Heart of Stone"
feature_heart_of_stone_desc = "Each time after this monster loses HP, other monsters in the same sector gain block equal to the HP loss."

petrified_name = "Petrified"
petrified_desc = "When this monster's \^debf56HP drops to \1 or below\^^\^ffffff, all damage received by it is reduced to 1 per hit (doesn't apply to influences doing direct damage)."

