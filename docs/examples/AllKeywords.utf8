disclaimer_title = "Disclaimer"
disclaimer_text = "Welcome to \^FCDA92HELLCARD\^^, traveler.\n\nFeel free to play the \^FCDA92Singleplayer\^^ mode, but we encourage you to also check out \^FCDA92Co-op multiplayer\^^ mode to play with friends or strangers.\n\nThis demo contains only a fraction of the \^FCDA92full game\^^ where you will find:\n\n- \^FCDA92New character class\^^\n- \^FCDA92400+ cards\^^ \n- \^FCDA9290+ artifacts\^^\n- \^FCDA92Higher difficulty levels\^^\n- \^FCDA92Final bosses\^^\n- \^FCDA92More starting artifacts\^^\n- \^FCDA92More cosmetic unlocks\^^\n\nIf you encounter a bug, have any ideas for the game, or simply fall into a poorly secured sinkhole, you can contact us via the \^FCDA92Feedback Widget\^^ on the left of the screen. We read all the feedback we get so get in touch.\n\nThis version gathers anonymous gameplay statistics and error logs.\n\nJoin our \^FCDA92Discord server\^^ to stay up to date with the game's development.\n\nHave fun!"
disclaimer_ea_text = "Welcome to \^FCDA92HELLCARD\^^, traveler.\n\nIf you encounter a bug, have any ideas for the game, or simply fall into a poorly secured sinkhole, you can contact us via the \^FCDA92Feedback Widget\^^ on the left of the screen. We read all the feedback we get so get in touch.\n\nJoin our \^FCDA92Discord server\^^ to stay up to date with the game's development.\n\nHave fun!"
disclaimer_discord = "Join Discord"
