###########################################################################################################
# CARD KEYWORDS
###########################################################################################################

keyword_block_title = "Block"
keyword_block_desc = "Block is subtracted before HP when a character takes damage. Block disappears at the beginning of the next turn."

keyword_mark_title = "Mark"
keyword_mark_desc = "All attacks on the marked monster deal +1 damage. Damage bonus can be stacked by playing mark on an already marked monster. Only 1 monster can be marked at a time."

keyword_stamina_title = "Stamina"
keyword_stamina_desc = "\^debf56Stamina\^^ can be added or subtracted by special card effects. When there are 10 points of \^debf56Stamina\^^ stacked, the character gets \^bf4747Stamina Burst\^^, and \^debf56Stamina\^^ resets to 0."

keyword_exhaust_title = "Exhaust"
keyword_exhaust_desc = "Card goes into the exhaust pile and cannot be used again in this battle."

keyword_focus_title = "Focus"
keyword_focus_desc = "Changes card parameter (e.g. mana/damage) with each draw. Lasts until the end of the current battle."

keyword_strain_title = "Strain"
keyword_strain_desc = "Cost increases by 1 mana with each use. Lasts until the end of the current battle."

keyword_freeze_title = "Freeze"
keyword_freeze_desc = "Frozen monsters can't move or attack. Freeze ends when a monster tries to move or attack (the action is unsuccessful, but it breaks the ice)."

keyword_combine_title = "Combine"
keyword_combine_desc = "Automatically exhaust X cards when they are in hand and add another card in their place."

keyword_bomb_title = "Bomb"
keyword_bomb_desc = "Bombs are placed in sections. There can only be one bomb per section. Playing a bomb card adds an Ignite card to the draw pile. Playing an Ignite card lets you choose which bomb you detonate."

keyword_stun_title = "Stun"
keyword_stun_desc = "Monster changes intent to Stun (and doesn't do anything this turn)."

keyword_take_title = "Take"
keyword_take_desc = "Take a card from the discard or draw pile and place it in your hand."

keyword_add_title = "Add"
keyword_add_desc = "Add card to your deck for this battle."

keyword_unstackable_title = "Unstackable"
keyword_unstackable_desc = "Influence card which cannot be stacked. Playing another copy of such a card won't increase the effect."

keyword_move_title = "Move"
keyword_move_desc = "Change monster position to another section."

keyword_disarm_title = "Disarm"
keyword_disarm_desc = "Prevents hero from getting \^debf56block\^^ from their own cards."

keyword_stamina_burst_title = "Stamina Burst"
keyword_stamina_burst_desc = "The next card played costs zero mana and is played twice."

keyword_tired_title = "Tired"
keyword_tired_desc = "Lose 1 mana at the beginning of the next turn."

keyword_shaky_hands_title = "Shaky Hands"
keyword_shaky_hands_desc = "All \s3Arrows and \sFQuarrels deal -1 damage in far range for the duration of this turn."

keyword_weak_title = "Weak"
keyword_weak_desc = "You deal less damage this turn."

keyword_change_title = "Parameter change"
keyword_change_desc = "All changes to card parameters last until the end of the current battle."

keyword_skill_title = "Skill Cards"
keyword_skill_desc = "Blue cards that are generally defensive and supporting."

keyword_attack_title = "Attack Cards"
keyword_attack_desc = "Red cards that usually deal direct damage."

keyword_influence_title = "Influence Cards"
keyword_influence_desc = "Green cards that apply buffs when used. If not stated otherwise, their effects last until the end of the current battle."

keyword_status_title = "Status Cards"
keyword_status_desc = "Black cards with negative effects."

keyword_burnout_title = "Burnout"
keyword_burnout_desc = "Hero can't get additional mana from cards this turn."

keyword_thinck_skin_title = "Thick Skin"
keyword_thinck_skin_desc = "Limits the maximum damage the Cook can get during one turn."

keyword_contraption_title = "Contraption"
keyword_contraption_desc = "Contraptions are a special kind of influences. They activate automatically, one by one. Using specific cards, they can be sorted, activated manually, scrapped for \sBScrews and \sDCores and even detonated for extra damage. They stay active even after their creator's death."

keyword_splash_title = "Splash damage"
keyword_splash_desc = "Splash damage is dealt to all monsters in a radius centered around a single target."

keyword_wrath_title = "Reckoning"
keyword_wrath_desc = "Reckoning represents damage that you will suffer at the end of the round unless you also have Grace. When you activate Reckoning you also gain Grace."

keyword_patience_title = "Grace"
keyword_patience_desc = "Grace is a one-turn influence that stops the activation of Reckoning."

keyword_cuts_title = "Cuts"
keyword_cuts_desc = "The HP loss for playing this card is not treated as damage and is unblockable but it cannot reduce your HP below 1. If your HP is lower than or equal to the HP cost, you lose no HP paying for this card."

keyword_cut_cards_title = "Cuts"
keyword_cut_cards_desc = "Cuts are cards that use your HP as cost for playing them. The HP loss for playing those cards is unblockable but it cannot reduce your HP below 1. If you HP is lower then the HP cost, you lose no HP paying for them."

keyword_webbed_title = "Webbed"
keyword_webbed_desc = "Playing a webbed card discards it, ending the webbed status but not giving any other card effects."

keyword_study_title = "Book Study"
keyword_study_desc = "Book cards have their Studying value shown at the top of the card. As long as this value is greater than 0, when you play a Book card it will use all your mana reducing Studying value by the same value. Once the Studying value is equal 0, you may play this card for free for its main effect."

keyword_trap_title = "Traps"
keyword_trap_desc = "Traps are played in section. There can only be one trap per section. Playing a new trap to a section with a trap replaces the old trap."

keyword_dlc_locked_title = "Available in DLC"
keyword_dlc_locked_desc = ""

