fracture_line_name = "Fracture Line"
fracture_line_desc = "All your Attacks deal +\1 damage to frozen or stunned monsters."

chip_and_shatter_name = "Chip And Shatter"
chip_and_shatter_desc = "All your Attacks deal +\1 damage to frozen or stunned monsters."

ice_breaker_name = "Ice Breaker"
ice_breaker_desc = "Your \s4Swords and \sIJis deal double damage to frozen monsters."

gong_name = "Gong"
gong_desc = "Your \s4Swords and \sIJis deal double damage to stunned monsters."

book_worm_name = "Book Worm"
book_worm_desc = "For the next \1 turn(s), when you kill a non-summoned monster you draw 1 card."

big_book_name = "Big Book"
big_book_desc = "For the next \1 turn(s), when a hero kills a non-summoned monster they draw 1 card."

book_of_books_name = "Book of Books"
book_of_books_desc = "For the next \1 turn(s), when a hero kills a non-summoned monster all heroes draw 1 card."

book_smash_name = "Book Smash"
book_smash_desc = "For the next \1 turn(s), all your Attack cards deal +2 damage."

book_stack_name = "Book Stack"
book_stack_desc = "For the next \1 turn(s), Attack cards of all heroes deal +2 damage."

little_red_book_name = "Little Red Book"
little_red_book_desc = "For the next \1 turn(s), Attack cards of all heroes deal +4 damage."

book_of_fortitude_name = "Book of Fortitude"
book_of_fortitude_desc = "For the next \1 turn(s), you gain 2 block when you play any Skill card."

book_cover_name = "Book Cover"
book_cover_desc = "For the next \1 turn(s), all heroes gain 2 block when they play any Skill card."

book_of_the_dead_name = "Book of the Dead"
book_of_the_dead_desc = "For the next \1 turn(s), all heroes gain 4 block when they play any Skill card."

trap_junk_name = "Junk Trap"
trap_junk_desc = "Gain 2 \sBScrews for each non-summoned monster killed in this section."

trap_tripwire_name = "Tripwire Trap"
trap_tripwire_desc = "If no monster is \^debf56marked\^^ add \1 \^debf56mark\^^ to a random monster in this section."

trap_magnet_name = "Magnet Trap"
trap_magnet_desc = "At the start of your turn, remove 3 \^debf56block\^^ from all monsters in this section."

trap_trojan_name = "Trojan Trap"
trap_trojan_desc = "All attacks deal +\1 damage to monsters in this section.\nGain 1 \sBScrew(s) for each non-summoned monster killed in this section."

trap_paint_name = "Paint Trap"
trap_paint_desc = "If no monster is \^debf56marked\^^ add \1 \^debf56mark\^^ to a random monster in this section. Use 1 \sBScrew(s) to \^debf56stun\^^ it."

trap_acid_name = "Acid Trap"
trap_acid_desc = "At the start of your turn, remove 8 \^debf56block\^^ from all monsters in this section."

trap_classic_name = "Classic Trap"
trap_classic_desc = "When a monster enters this section, use 1 \sBScrew(s) to \^debf56stun\^^ and deal \1 damage to it. If no monster is \^debf56marked\^^ add \1 \^debf56mark\^^ to a random monster in this section."

trap_jack_name = "Jack Trap"
trap_jack_desc = "At the start of your turn, \^debf56stun\^^ and move 1 random monster from this section to a random section.\nRemove \^debf56block\^^ from all other monsters in the new section."

trap_kill_zone_name = "Kill Zone Trap"
trap_kill_zone_desc = "All attacks deal +\1 damage to monsters in this section.\nGain 1 \sBScrew(s) for each non-summoned monster killed in this section."

