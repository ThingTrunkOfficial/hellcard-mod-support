car_002_war_desc  = "Give \2 \^debf56block\^^."

car_003_war_title = "Swords Akimbo"
car_003_war_desc  = "Deal \1 damage in a short wide cone. \^debf56Strain\^^."

car_004_war_title = "Heavy Sword"
car_004_war_desc  = "Deal \1 damage.\nUse 2 \^debf56Stamina\^^ for additional \5 damage."

car_005_war_title = "Mighty Blow"
car_005_war_desc  = "Deal \1 damage in a medium radius.\nRandom monster in the radius is dealt additional \5 damage."

car_006_war_title = "Initiative"
car_006_war_desc  = "Deal \5 damage.\nDeal \1 damage if the monster's intent is attack."

car_007_war_title = "Counter Strike"
car_007_war_desc  = "Deal \1 damage to the monster if the monster's attack leaves you with \^debf56block\^^.\n\^debf56Exhaust\^^. \^debf56Unstackable\^^."

car_008_war_title = "Tip the Scales"
car_008_war_desc  = "Gain \2 \^debf56block\^^ after you kill a monster.\n\^debf56Strain\^^."

car_009_war_title = "Turtle Up"
car_009_war_desc  = "Double \^debf56block\^^ for all heroes."

car_010_war_title = "Tactics"
car_010_war_desc  = "Draw \3 cards.\nGain \2 \^debf56block\^^."

car_011_war_title = "Heroism"
car_011_war_desc  = "Give \2 \^debf56block\^^ to all heroes."

car_012_war_title = "Bait"
car_012_war_desc  = "Your attacks deal 1 more damage in near range.\n\^debf56Exhaust\^^."

car_013_war_title = "Camaraderie"
car_013_war_desc  = "Everybody draws \3 card(s)."

car_014_war_title = "Judgmental Scowl"
car_014_war_desc  = "Break \^debf56block\^^.\nGain \2 \^debf56block\^^."

car_015_war_title = "Preparation"
car_015_war_desc  = "Add \5 \^debf56Stamina\^^."

car_016_war_title = "Side Sword"
car_016_war_desc  = "Deal \1 damage. Use \6 \^debf56Stamina\^^ for additional \5 damage."

car_017_war_title = "Mighty Weaponry"
car_017_war_desc  = "Deal \1 damage in a medium radius. Lose \^debf56block\^^. Get \^bf4747Disarm\^^."

car_018_war_title = "Deatheater Sword"
car_018_war_desc  = "Deal \1 damage.\nIf it kills the monster, increase the damage of this card by \5."

car_019_war_title = "Charge"
car_019_war_desc  = "Deal \1 damage.\n\^debf56Focus\^^ with +\5 damage. \^debf56Strain\^^."

car_020_war_title = "Boomerang Shield"
car_020_war_desc  = "Deal damage equal to your \^debf56block\^^ value to the first monster in a long narrow cone."

car_021_war_title = "Reckless Charge"
car_021_war_desc  = "Deal damage equal to the cost of all cards in your hand (\1) in a medium radius. Discard all non \^debf56Attack\^^ cards."

car_022_war_title = "Fury"
car_022_war_desc  = "Deal \1 damage in a medium radius. Lose \^debf56block\^^. Get \^bf4747Disarm\^^."

car_023_war_title = "Crystal Sword"
car_023_war_desc  = "Deal \1 damage. If this kills the monster, reduce damage by \5."

car_024_war_title = "Offering"
car_024_war_desc  = "Deal \1 damage. Lose \5 HP."

car_025_war_title = "Double-edged Sword"
car_025_war_desc  = "Deal \1 damage. Use \7 \^debf56Stamina\^^ or get damaged for each \^debf56Stamina\^^ missing."

car_026_war_title = "Groundbreaker"
car_026_war_desc  = "Deal \1 damage in a medium radius."

car_027_war_title = "Whirlwind"
car_027_war_desc  = "Deal \1 damage to ALL monsters in near range.\n\^debf56Strain\^^."

car_028_war_title = "Momentum"
car_028_war_desc  = "Give 1 \^debf56block\^^ to all heroes every time you play an \^debf56Attack\^^ card.\n\^debf56Strain\^^."

car_029_war_title = "Insult"
car_029_war_desc  = "Your \s4Swords deal +\1 damage. \^debf56Exhaust\^^."

car_030_war_title = "Lie in Wait"
car_030_war_desc  = "Get \5 \^debf56Stamina\^^ if you have any unused mana at the end of your turn.\n\^debf56Exhaust\^^."

car_031_war_title = "Lift"
car_031_war_desc  = "Get \5 \^debf56Stamina\^^ for every 8th damage you deal. \^debf56Exhaust.\^^ \^debf56Unstackable\^^."

car_032_war_title = "Starlight Strike"
car_032_war_desc  = "Deal \1 damage minus your current \^debf56block\^^ in a medium radius and get \7 \^debf56Stamina\^^ for every monster killed. Discard all \^debf56Skill\^^ cards."

car_033_war_title = "Defiant Roar"
car_033_war_desc  = "Break monsters' \^debf56block\^^ in a long medium cone. Gain \7 \^debf56block\^^ for each monster in the cone."

car_034_war_title = "Deep Breath"
car_034_war_desc  = "Add \5 \^debf56Stamina\^^. Draw \3 cards. Gain \2 \^debf56block\^^."

car_035_war_title = "Barricade"
car_035_war_desc  = "Give \2 \^debf56block\^^ to all heroes."

car_036_war_title = "Provoke"
car_036_war_desc  = "Add random \5 \^debf56Attack\^^ cards to the draw pile. \^debf56Take\^^ \3 random \^debf56Attack\^^ cards."

car_038_war_title = "Root"
car_038_war_desc  = "Your \^debf56block\^^ is not removed at the start of your turn.\nGain \2 \^debf56block\^^ at the beginning of your turn. \^debf56Exhaust\^^."

car_039_war_title = "Reverse"
car_039_war_desc  = "Deal damage equal to monster's Strength."

car_040_war_title = "Deathblow"
car_040_war_desc  = "Kill a wounded monster with \6 or less HP."

car_041_war_title = "Storm of Blades"
car_041_war_desc  = "Deal \6 damage for each \s4Sword in your deck (\1) in a long medium cone. Use \7 \^debf56Stamina\^^ to repeat."

car_042_war_title = "Save"
car_042_war_desc  = "Your \^debf56block\^^ is not removed at the start of your turn. \^debf56Unstackable\^^. \^debf56Exhaust\^^."

car_043_war_title = "One For All"
car_043_war_desc  = "All heroes get a random legendary card to hand."

car_044_war_title = "Arsenal"
car_044_war_desc  = "Everybody draws 2 cards. Use all \^debf56Stamina\^^ for additional cards (\3 \^debf56Stamina\^^ each)."

car_045_war_title = "Vigor"
car_045_war_desc  = "When out of mana use \^debf56Stamina\^^ instead (1 mana costs \5 \^debf56Stamina\^^). \^debf56Unstackable\^^. \^debf56Exhaust\^^."

car_046_war_title = "Cauterize Wound"
car_046_war_desc  = "Use \^debf56Stamina\^^ to heal any hero.\n\^debf56Strain\^^."

car_048_war_title = "Overwhelm"
car_048_war_desc  = "Add random \1 \^debf56Attack\^^ cards to the draw pile. Take \2 random \^debf56Attack\^^ cards. They cost \5 until played or turn ends."

car_049_war_title = "Gut Punch"
car_049_war_desc  = "Deal \1 damage plus \^debf56Stamina\^^. Double damage if the monster has \^debf56block\^^."

car_050_war_title = "Second Wind"
car_050_war_desc  = "Get \6 \^debf56Stamina\^^, draw \3 card(s) and gain \5 mana. \^debf56Exhaust\^^."

car_051_war_title = "Battle Juice"
car_051_war_desc  = "Get \6 \^debf56Stamina\^^. All heroes get \5 mana and draw \3 card(s).\n\^debf56Exhaust\^^."

car_052_war_title = "All Out Strike"
car_052_war_desc  = "Deal \1 damage minus your current \^debf56block\^^ in a medium radius. Discard all \^debf56Skill\^^ cards."

car_053_war_title = "Dread"
car_053_war_desc  = "Give \2 \^debf56block\^^ to all heroes after you kill a monster. \^debf56Strain\^^."

car_054_war_title = "Doom"
car_054_war_desc  = "\^debf56Mark\^^. If any monster was already \^debf56marked\^^, deal them \1 damage."

car_055_war_title = "Fool's Guard"
car_055_war_desc  = "Gain \2 \^debf56block\^^ at the start of a turn. Gain \^bf4747Weak\^^ for one turn.\n\^debf56Exhaust\^^."

car_056_war_title = "Ox"
car_056_war_desc  = "Double your \^debf56block\^^."

car_057_war_title = "Crown"
car_057_war_desc  = "Your \s4Swords deal +2 damage. \^debf56Exhaust\^^."

car_058_war_title = "Pacifist"
car_058_war_desc  = "Give \2 \^debf56block\^^. \^debf56Take\^^ a random \^debf56Skill\^^ card."

car_059_war_title = "¡No Pasarán!"
car_059_war_desc  = "Give \2 \^debf56block\^^ to all heroes. \^debf56Take\^^ a random \^debf56Skill\^^ card."

car_060_war_title = "Iron Door"
car_060_war_desc  = "Give \2 \^debf56block\^^ to all heroes. \5 if you don't have an \^debf56Attack\^^ card in hand."

car_061_war_title = "Akanbe"
car_061_war_desc  = "\^debf56Move\^^ the selected monster to your near section."

car_062_war_title = "Taunt"
car_062_war_desc  = "\^debf56Move\^^ the selected monster to your near section. \^debf56Take\^^ a random \^debf56Attack\^^ card."

car_064_war_title = "Weakest Link"
car_064_war_desc  = "\^debf56Move\^^ the selected monster to your near section. Gain \6 \^debf56Stamina\^^."

car_065_war_title = "Ambush"
car_065_war_desc  = "\^debf56Move\^^ the selected monster to your near section. Gain \5 mana, \6 \^debf56Stamina\^^ and \^debf56take\^^ a random \^debf56Attack\^^ card."

car_066_war_title = "Haymaker"
car_066_war_desc  = "Deal \1 damage. Deal additional \5 damage if the monster has \^debf56block\^^."

car_067_war_title = "Knuckle Crack"
car_067_war_desc  = "Get \5 \^debf56Stamina\^^. \^debf56Strain\^^."

car_068_war_title = "Flow"
car_068_war_desc  = "Gain 1 \^debf56block\^^ every time you play an \^debf56Attack\^^ card. \^debf56Strain\^^."

car_069_war_title = "Padded Shield"
car_069_war_desc  = "Get 2 \^debf56Stamina\^^ if the monster's attack leaves you with \^debf56block\^^. \^debf56Exhaust\^^."

car_070_war_title = "Safeguard"
car_070_war_desc  = "Give \2 \^debf56block\^^."

car_071_war_title = "Diamond Knife"
car_071_war_desc  = "Deal \1 damage. Increase the damage of this card by \5 with each play."

car_072_war_title = "Snap Back"
car_072_war_desc  = "Deal 1 damage to the monster if the monster's attack leaves you with \^debf56block\^^."

car_073_war_title = "Third Law"
car_073_war_desc  = "When the monster's attack leaves you with \^debf56block\^^, deal equal damage to the attacker and get 2 \^debf56Stamina\^^. \^debf56Unstackable\^^. \^debf56Exhaust\^^."

car_074_war_title = "Breakthrough"
car_074_war_desc  = "Deal damage equal to your \^debf56block\^^ in a long narrow cone."

car_075_war_title = "Immutability"
